[
  {
    "name": "gold, loyal, SAVE10, express: 199*2*0.82*0.90 + 20% tax + 9.50",
    "inputs": {
      "order_id": 1,
      "region": "EU",
      "coupon": "SAVE10"
    },
    "mock": "../../fixtures/marketplace.json",
    "expect": {
      "result": {
        "ok": {
          "receipt": {
            "bill": {
              "shipping": "9.50",
              "subtotal": "293.72",
              "tax": "58.74",
              "total": "361.97"
            },
            "eta_days": 1,
            "order": 1,
            "reservation": "res_501",
            "tier": "gold",
            "transaction": "tx_9001"
          }
        }
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "OrderFetch",
          "args": {
            "id": 1
          },
          "result": {
            "ok": {
              "buyer": 101,
              "express": true,
              "qty": 2,
              "sku": "headphones"
            }
          }
        },
        {
          "kind": "fx~",
          "effect": "Audit",
          "args": {
            "event": "checkout_started",
            "order": 1
          }
        },
        {
          "kind": "fx",
          "effect": "Buyer",
          "args": {
            "id": 101
          },
          "result": {
            "ok": {
              "orders": 12,
              "risk": 10,
              "tier": "gold",
              "wallet": "2000.00"
            }
          }
        },
        {
          "kind": "fx",
          "effect": "Catalog",
          "args": {
            "sku": "headphones"
          },
          "result": {
            "ok": {
              "category": "electronics",
              "kg": "0.40",
              "price": "199.00"
            }
          }
        },
        {
          "kind": "fx",
          "effect": "Reserve",
          "args": {
            "qty": 2,
            "sku": "headphones"
          },
          "result": {
            "ok": "res_501"
          }
        },
        {
          "kind": "fx",
          "effect": "TaxRate",
          "args": {
            "category": "electronics",
            "region": "EU"
          },
          "result": {
            "ok": "0.20"
          }
        },
        {
          "kind": "fx",
          "effect": "Quote",
          "args": {
            "express": true,
            "kg": "0.80",
            "region": "EU"
          },
          "result": {
            "ok": "9.50"
          }
        },
        {
          "kind": "fx",
          "effect": "Charge",
          "args": {
            "amount": "361.96880000",
            "buyer": 101
          },
          "result": {
            "ok": "tx_9001"
          }
        },
        {
          "kind": "fx~",
          "effect": "Notify",
          "args": {
            "buyer": 101,
            "message": "order confirmed"
          }
        },
        {
          "kind": "fx~",
          "effect": "Metric",
          "args": {
            "name": "revenue",
            "value": "361.96880000"
          }
        }
      ]
    }
  },
