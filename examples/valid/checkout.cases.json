  },
  {
    "name": "unknown customer pays as a guest; no LogAsync because USR never ran",
    "inputs": {
      "order_id": 6
    },
    "mock": "../../fixtures/checkout.json",
    "expect": {
      "result": {
        "ok": {
          "charged": "33.50"
        }
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "OrderFetch",
          "args": {
            "id": 6
          },
          "result": {
            "ok": {
              "kg": "1.00",
              "sku": "apple",
              "usr": 999,
              "zone": "east"
            }
          }
        },
        {
          "kind": "fx",
          "effect": "Catalog",
          "args": {
            "sku": "apple"
          },
          "result": {
            "ok": {
              "price": "3.50",
              "stock_kg": "100.00"
            }
          }
        },
        {
          "kind": "fx",
          "effect": "DbFetch",
          "args": {
            "key": 999,
            "table": "usr"
          },
          "result": {
            "err": "NotFound"
          }
        },
        {
          "kind": "fx",
          "effect": "ShipQuote",
          "args": {
            "kg": "1.00",
            "zone": "east"
          },
          "result": {
            "err": "NoRoute"
          }
        }
      ]
    }
  },
  {
    "name": "missing order propagates NotFound",
    "inputs": {
      "order_id": 999
    },
    "mock": "../../fixtures/checkout.json",
    "expect": {
      "result": {
        "err": "NotFound"
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "OrderFetch",
          "args": {
            "id": 999
          },
          "result": {
            "err": "NotFound"
          }
        }
      ]
    }
  }
]
