    "expect": {
      "result": {
        "err": "UnknownSku"
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "OrderFetch",
          "args": {
            "id": 5
          },
          "result": {
            "ok": {
              "kg": "1.00",
              "sku": "kiwi",
              "usr": 1,
              "zone": "north"
            }
          }
        },
        {
          "kind": "fx",
          "effect": "Catalog",
          "args": {
            "sku": "kiwi"
          },
          "result": {
            "err": "UnknownSku"
          }
        }
      ]
