            "sku": "mug"
          },
          "result": {
            "ok": {
              "kg": "0.30",
              "price": "12.00"
            }
          },
          "at": [
            [
              "PriceLine",
              0
            ]
          ]
        },
        {
          "kind": "fx",
          "effect": "Reserve",
          "args": {
            "qty": 2,
            "sku": "mug"
          },
          "result": {
            "ok": "r-mug"
          },
          "at": [
            [
              "TryReserve",
              0
            ]
          ]
        },
        {
          "kind": "fx",
          "effect": "Charge",
          "args": {
            "amount": "28.80",
