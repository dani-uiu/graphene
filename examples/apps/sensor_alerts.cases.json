  {
    "name": "unknown device propagates UnknownDevice",
    "inputs": {
      "device": "toaster",
      "temp_c": 20,
      "humidity": 40
    },
    "mock": "../mocks/sensors.json",
    "expect": {
      "result": {
        "err": "UnknownDevice"
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "Limits",
          "args": {
            "device": "toaster"
          },
          "result": {
            "err": "UnknownDevice"
          }
        }
      ]
    }
  }
