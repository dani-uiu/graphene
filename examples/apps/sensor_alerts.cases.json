[
  {
    "name": "boiler above critical pages",
    "inputs": {
      "device": "boiler-1",
      "temp_c": 99,
      "humidity": 40
    },
    "mock": "../mocks/sensors.json",
    "expect": {
      "result": {
        "ok": {
          "status": {
            "delta": 4,
            "level": "critical"
          }
        }
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "Limits",
          "args": {
            "device": "boiler-1"
          },
          "result": {
            "ok": {
              "critical": 95,
              "high": 80,
              "low": 10
            }
          }
        },
        {
          "kind": "fx~",
          "effect": "Log",
          "args": {
            "device": "boiler-1",
            "reading": 99
          }
        },
        {
          "kind": "fx~",
          "effect": "Page",
          "args": {
            "device": "boiler-1",
            "level": "critical"
          }
        }
      ]
    }
  },
  {
    "name": "boiler above high is a warning",
    "inputs": {
      "device": "boiler-1",
      "temp_c": 85,
      "humidity": 40
    },
    "mock": "../mocks/sensors.json",
    "expect": {
      "result": {
        "ok": {
          "status": {
            "delta": 5,
            "level": "too_hot"
          }
        }
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "Limits",
          "args": {
            "device": "boiler-1"
          },
          "result": {
            "ok": {
              "critical": 95,
              "high": 80,
              "low": 10
            }
          }
        },
        {
          "kind": "fx~",
          "effect": "Log",
          "args": {
            "device": "boiler-1",
            "reading": 85
          }
        }
      ]
    }
  },
