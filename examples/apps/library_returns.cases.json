[
  {
    "name": "adult, three books (one early): 1.75 + 0.00 + 7.75 = 9.50, warned",
    "inputs": {
      "member_id": 1,
      "member": "Adult",
      "today": "2026-11-02",
      "loans": [
        {
          "isbn": "A",
          "due": "2026-10-26"
        },
        {
          "isbn": "B",
          "due": "2026-11-05"
        },
        {
          "isbn": "C",
          "due": "2026-10-02"
        }
      ]
    },
    "mock": "../mocks/lending.json",
    "expect": {
      "result": {
        "ok": {
          "receipt": {
            "in": 3,
            "fines": [
              {
                "isbn": "A",
                "days_late": 7,
                "fine": "1.75"
              },
              {
                "isbn": "B",
                "days_late": 0,
                "fine": "0.00"
              },
              {
                "isbn": "C",
                "days_late": 31,
                "fine": "7.75"
              }
            ],
            "owed": "9.50",
            "oldest_due": "2026-10-02",
            "standing": "Warned",
            "limit": 3,
            "review_on": "2026-12-02"
          }
        }
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "History",
          "args": {
            "member_id": 1
          },
          "result": {
            "ok": {
              "since": "2020-01-15",
              "standing": "Good"
            }
          }
        },
        {
          "kind": "fx~",
          "effect": "Notify",
          "args": {
            "member_id": 1,
            "owed": "9.50",
            "standing": "Warned"
          }
        }
      ]
    }
  },
