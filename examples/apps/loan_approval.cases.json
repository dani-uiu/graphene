  {
    "name": "unverified income is declined and audited",
    "inputs": {
      "applicant": 6,
      "amount": "5000.00",
      "months": 12
    },
    "mock": "../mocks/loans.json",
    "expect": {
      "result": {
        "err": "IncomeUnverified"
      },
      "effects": [
        {
          "kind": "fx",
          "effect": "Credit",
          "args": {
            "applicant": 6
          },
          "result": {
            "ok": {
              "open_loans": 0,
              "score": 720
            }
          }
        },
        {
          "kind": "fx",
          "effect": "Income",
          "args": {
            "applicant": 6
          },
          "result": {
            "err": "Unverified"
          }
        },
        {
          "kind": "fx~",
          "effect": "Audit",
          "args": {
            "applicant": 6,
            "event": "income_unverified"
          }
        }
      ]
    }
  }
