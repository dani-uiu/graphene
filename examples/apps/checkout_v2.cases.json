          "args": {
            "sku": "truffle"
          },
          "result": {
            "ok": {
              "kg": "0.25",
              "price": "900.00",
              "stock": 3
            }
          }
        },
        {
          "kind": "fx",
          "effect": "DbFetch",
          "args": {
            "key": 2,
            "table": "usr"
          },
          "result": {
            "ok": {
              "bal": "100.00",
              "role": "basic"
            }
          }
        },
        {
          "kind": "fx~",
          "effect": "LogAsync",
          "args": {
            "event": "checkout",
            "role": "basic"
          }
        },
        {
          "kind": "fx",
          "effect": "ShipQuote",
          "args": {
            "kg": "0.50",
            "zone": "north"
          },
          "result": {
            "err": "NoRoute"
          }
        }
      ]
    }
  },
