(* ===================================================================== *)
(*  Graphene v0.4 — grammar                                               *)
(*                                                                        *)
(*  Notation: ISO 14977-style EBNF.                                       *)
(*    { x }  zero or more     [ x ]  optional     ( a | b )  choice       *)
(*  Terminals in double quotes are written in their canonical ASCII      *)
(*  form. The Unicode aliases in section L4 are accepted as the same     *)
(*  tokens by the lexer.                                                  *)
(*                                                                        *)
(*  The grammar is deliberately a little more permissive than the        *)
(*  language. Rules marked "checked:" are rejected by the checker, not   *)
(*  the parser, so the user gets a precise diagnostic with a fix hint    *)
(*  instead of a generic syntax error.                                    *)
(* ===================================================================== *)


(* --------------------------------------------------------------------- *)
(*  L. LEXICAL STRUCTURE                                                  *)
(* --------------------------------------------------------------------- *)

(* L1. Lines. One statement per line. Newline is a token. Spaces and     *)
(*     tabs separate tokens and are otherwise ignored. "\r\n" and "\n"   *)
(*     are both accepted as NL.                                           *)

NL          = [ "\r" ] , "\n" ;
              (* v0.3: a NL inside an open "(", "{" or "[" does not end the *)
              (*       statement, so one statement may span several lines. *)
COMMENT     = "//" , { any character except NL } ;

(* L2. Header. Only valid as the very first line of the file. "#" may    *)
(*     not appear anywhere else (P005).                                   *)

HEADER      = "#!graphene" , " " , VERSION ;
VERSION     = DIGITS , "." , DIGITS ;           (* "0.1" to "0.4"; else P003 *)
(* Under a "0.1" header, every construct marked "v0.2" or "v0.3" below is *)
(* P006; under "0.2", every construct marked "v0.3" is P006.             *)

(* L3. Atoms.                                                             *)

IDENT       = ( LETTER | "_" ) , { LETTER | DIGIT | "_" } ;   (* not a reserved word *)
INT         = DIGITS ;                          (* must fit in u64: P004 *)
DECIMAL     = DIGITS , "." , DIGITS ;           (* exact; at most 28 significant digits: P004 *)
STRING      = '"' , { STRCHAR | '\"' | '\\' } , '"' ;   (* any other escape: P002 *)
STRCHAR     = any character except '"', '\', NL ;
LETTER      = "A".."Z" | "a".."z" ;
DIGIT       = "0".."9" ;
DIGITS      = DIGIT , { DIGIT } ;

(* L4. Reserved words (cannot be used as identifiers):                   *)
(*       in out fail sink extern fx fx~ f match assert err true false    *)
(*                                                                        *)
(*     Contextual words (special only right after "assert", ordinary     *)
(*     identifiers everywhere else, e.g. "out total: dec" is legal):     *)
(*       total indep                                                      *)
(*                                                                        *)
(*     Unicode aliases (lexer maps them to the ASCII token):             *)
(*       ➔ (U+2794)  ->        ⚙ (U+2699)  fx       ⊗ (U+2297)  fx~       *)
(*       𝑓 (U+1D453) f         ?           match    × (U+00D7)  *         *)
(*       ⫫ (U+2AEB)  indep                                                *)
(*                                                                        *)
(*     v0.3 adds contextual words, like total/indep: graph call map    *)
(*     filter each const. They act as keywords only where a statement,  *)
(*     operation or argument starts, so they remain usable as names.    *)
(*     v0.4 adds the statement words type enum import, and date in type  *)
(*     position and before "(" in expressions.                          *)
(*                                                                        *)
(*     Maximal munch: "fx~" before "fx", "->" before "-", "||" before    *)
(*     "|", "==" "!=" "<=" ">=" "=>" before their one-char prefixes.      *)


(* --------------------------------------------------------------------- *)
(*  S. STATEMENTS                                                         *)
(* --------------------------------------------------------------------- *)

program     = HEADER , NL , { line } , [ stmt ] , [ COMMENT ] ;   (* final NL optional *)
line        = [ stmt ] , [ COMMENT ] , NL ;

stmt        = meta
            | import_decl                                      (* v0.4 *)
            | type_decl                                        (* v0.4 *)
            | enum_decl                                        (* v0.4 *)
            | extern_decl
            | const_decl                                       (* v0.3 *)
            | graph_decl                                       (* v0.3 *)
            | input
            | assertion
            | flow
            | match_stmt
            | output ;

import_decl = "import" , STRING ;                             (* v0.4 *)
              (* STRING is a path relative to this file, ending in .grph. *)
              (* checked (G018): the file exists, is a library (only      *)
              (*   import/type/enum/const/extern/graph statements), and    *)
              (*   no import cycle; (G008) something from it is used.      *)
              (* Names are flat: everything the library declares is        *)
              (* visible here; a clash with a local name is G013.          *)

type_decl   = "type" , IDENT , "=" , type ;                    (* v0.4 *)
              (* checked (G019): no alias refers to itself, directly or    *)
              (*   through other aliases; (G013) unique among types and    *)
              (*   not a built-in type name; (G008) used somewhere.        *)

enum_decl   = "enum" , IDENT , "{" , IDENT , { "," , IDENT } , [ "," ] , "}" ;   (* v0.4 *)
              (* checked (G013): variant names unique within the enum.     *)

const_decl  = "const" , IDENT , ":" , type , "=" , expr ;      (* v0.3 *)
              (* checked: expr is a literal, or a record/list of literals *)
              (* checked (G003): value matches the type; (G013) unique;   *)
              (*                 (G008) referenced somewhere.             *)

graph_decl  = "graph" , IDENT , "(" , [ gparams ] , ")" , "->" , type ,
              [ "!" , IDENT , { "|" , IDENT } ] , "{" , NL ,
              { line } , "}" ;                                 (* v0.3 *)
gparams     = gparam , { "," , gparam } , [ "," ] ;
gparam      = IDENT , ":" , type , [ "->" , IDENT ] ;          (* like `in` *)
              (* The body is ordinary statements (no extern, const, graph  *)
              (* or `in`); it ends in exactly one bare `out`.              *)
              (* checked (G020): the body is always total.                 *)
              (* checked (G017): `out` has the declared type; every raised *)
              (*                 error is declared after "!".              *)
              (* checked (G015): no cycle in the call graph.               *)

(* Dispatch is LL(2)/LL(3): "@", "extern", "in", "assert", "(" decide    *)
(* directly; otherwise IDENT "->" then the next token decides:           *)
(*   f / fx / fx~ -> flow      match -> match_stmt      out / fail -> output *)

meta        = "@intent" , STRING ;

extern_decl = "extern" , ( "fx" | "fx~" ) , IDENT ,
              "(" , [ params ] , ")" ,
              [ "->" , type ] ,
              [ "!" , IDENT , { "|" , IDENT } ] ;
              (* checked (G003): "fx"  must declare a return type.        *)
              (* checked (G003): "fx~" must declare neither a return type *)
              (*                 nor errors.                              *)
              (* checked (G013): extern names and error names within one  *)
              (*                 declaration are unique.                  *)

input       = "in" , IDENT , ":" , type , [ "->" , IDENT ] ;   (* v0.2: node optional *)
              (* first IDENT  = input name: the value, used in expressions *)
              (* second IDENT = input node: the graph handle, used as a   *)
              (*                flow source; not usable in expressions.   *)
              (*                v0.2: may be omitted when the input is    *)
              (*                only used in expressions (G008 if unused) *)
              (* checked (G003): input types are scalar (no records).     *)

flow        = source , "->" , op , "->" , target , { err_edge } ;   (* v0.2: several *)
source      = IDENT
            | "(" , IDENT , "," , IDENT , { "," , IDENT } , [ "," ] , ")" ;   (* join: 2+ members *)
op          = "f" , "(" , expr , ")"
            | "fx" , IDENT , "(" , [ args ] , ")"
            | "fx~" , IDENT , "(" , [ args ] , ")"
            | "call" , IDENT , "(" , [ args ] , ")"            (* v0.3 *)
            | "map" , IDENT , "(" , [ args ] , ")"             (* v0.3 *)
            | "filter" , IDENT , "(" , [ args ] , ")" ;        (* v0.3 *)
              (* checked (G016): map/filter have exactly one `each`       *)
              (*                 argument; fx/fx~ at most one; call none; *)
              (*                 an `each` argument is a list [T] where   *)
              (*                 the parameter is T.                      *)
target      = IDENT , [ ":" , type ]
            | "sink" , IDENT ;
err_edge    = "|" , "err" , [ IDENT ] , "->" , IDENT ;   (* v0.2: variant name *)
              (* checked (G005): present iff op is "fx" with declared errors, *)
              (*                 and every declared variant is covered      *)
              (* checked (G002): a named variant is declared by the effect   *)
              (* checked (G014): no variant twice; catch-all last and useful  *)
              (* checked (G010): "fx~" target must be "sink"; "sink" only *)
              (*                 after "fx~".                             *)

match_stmt  = IDENT , "->" , "match" , expr , "{" , arm , { "," , arm } , [ "," ] , "}" ;
arm         = ( literal | "_" | IDENT ) , "=>" , IDENT ;     (* IDENT: v0.4 enum variant *)
              (* a bare IDENT pattern names a variant of the scrutinee's   *)
              (* enum (G002 if it has no such variant).                    *)
              (* checked (G004): exhaustive.                               *)
              (* checked (G014): no duplicate literal, nothing after "_".  *)

output      = IDENT , "->" , ( "out" , IDENT , ":" , type
                             | "out"                           (* v0.3, subgraph bodies only *)
                             | "fail" , [ IDENT ] ) ;

assertion   = "assert" , ( "total"
                         | "indep" , "(" , IDENT , "," , "out" , ")" ) ;


(* --------------------------------------------------------------------- *)
(*  T. TYPES                                                              *)
(* --------------------------------------------------------------------- *)

type        = "u64" | "i64" | "dec" | "bool" | "str"
            | "date"                                           (* v0.4 *)
            | IDENT                                            (* v0.4: alias or enum *)
            | "dec" , "(" , INT , ")"                          (* v0.3: output scale 0..28 *)
            | "[" , type , "]"                                 (* v0.3: list *)
            | "{" , field_ty , { "," , field_ty } , [ "," ] , "}" ;
field_ty    = name , ":" , type ;
name        = IDENT | keyword ;                                (* any version *)
              (* Keywords (f, in, out, match, ...) are accepted as field   *)
              (* names after "." and before ":" in records (D-063).        *)
              (* u64 i64 dec bool str are matched as IDENT text in type   *)
              (* position, so they stay usable as field names.            *)
              (* checked (G013): field names unique within a record.      *)

params      = IDENT , ":" , type , { "," , IDENT , ":" , type } , [ "," ] ;
args        = arg , { "," , arg } , [ "," ] ;
arg         = IDENT , ":" , [ "each" ] , expr ;                (* v0.3: each *)
              (* checked (G003): args name exactly the declared params,   *)
              (*                 any order, each once, matching types.    *)


(* --------------------------------------------------------------------- *)
(*  E. EXPRESSIONS  (lowest to highest precedence)                        *)
(* --------------------------------------------------------------------- *)

expr        = if_expr | or_expr ;
if_expr     = "if" , expr , "then" , expr , "else" , expr ;  (* v0.3.1 *)
              (* `if`, `then`, `else` are contextual: `if` starts a        *)
              (* conditional only when an expression follows it. The       *)
              (* else-branch extends as far right as possible.             *)
or_expr     = and_expr , { "||" , and_expr } ;                 (* left-assoc *)
and_expr    = cmp_expr , { "&&" , cmp_expr } ;                 (* left-assoc *)
cmp_expr    = sum , [ ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) , sum ] ;  (* non-assoc *)
sum         = prod , { ( "+" | "-" | "++" ) , prod } ;         (* left-assoc; ++ v0.3.1 *)
prod        = unary , { ( "*" | "/" | "%" ) , unary } ;        (* left-assoc; % v0.3.1 *)
unary       = [ "!" | "-" ] , postfix ;                        (* at most one prefix *)
postfix     = atom , { "." , name | "[" , expr , "]" } ;       (* [i]: v0.3.1 *)
              (* `Enum.Variant` (v0.4) is this same shape: an atom naming  *)
              (* an enum, then "." and the variant.                         *)
atom        = literal | IDENT | "(" , expr , ")"
            | record_lit                                     (* v0.2 *)
            | conversion                                     (* v0.2 *)
            | list_lit                                       (* v0.3 *)
            | builtin                                        (* v0.3 *)
            | date_lit ;                                     (* v0.4 *)
list_lit    = "[" , [ expr , { "," , expr } , [ "," ] ] , "]" ;
              (* checked (G003): one element type; `[]` needs an expected  *)
              (*                 type from an annotation or parameter.     *)
builtin     = ( "len" | "sum" | "min" | "max" | "all" | "any" | "contains"
              | "round" | "floor" | "ceil"
              | "str" | "abs" | "pow" | "avg" | "first" | "last"        (* v0.3.1 *)
              | "sort" | "reverse" | "upper" | "lower"
              | "starts_with" | "ends_with"
            | "days_between" | "add_days" | "year" | "month"       (* v0.4 *)
            | "day" | "weekday" ) , "(" , expr , { "," , expr } , ")" ;
date_lit    = "date" , "(" , STRING , ")" ;                    (* v0.4 *)
              (* checked (G003): STRING is a valid YYYY-MM-DD date.        *)
              (* names stay identifiers: IDENT "(" only ever means a call. *)
              (* round/floor/ceil take an INT literal scale as 2nd arg;    *)
              (* pow takes an INT literal exponent (0 to 1000).            *)
record_lit  = "{" , field_init , { "," , field_init } , [ "," ] , "}" ;
field_init  = name , ":" , expr ;
              (* checked (G013): field names unique within the literal.   *)
conversion  = ( "u64" | "i64" | "dec" ) , "(" , expr , ")" ;
              (* the type names stay ordinary identifiers: IDENT "(" never *)
              (* starts anything else, so there is no ambiguity.            *)
literal     = INT | DECIMAL | STRING | "true" | "false" ;
              (* checked (G012): before 0.3 the right operand of "/" must *)
              (*   be a bare non-zero literal; from 0.3 on, a non-literal  *)
              (*   divisor of "/" or "%" must be proven non-zero (§8.3).   *)
